{% extends 'layouts/base.twig' %}
{% block title %}Users — Admin{% endblock %}
{% block content %}
<div class="dash-layout">
  {% set admin_page = 'users' %}
  {% include 'admin/partials/sidebar.twig' %}
  <main class="dash-main">
    <div class="dash-header"><h1>Users</h1></div>
    <form class="filter-bar" method="GET">
      <input type="text" name="q" value="{{ search }}" placeholder="Search name or email...">
      <select name="status"><option value="">All Statuses</option><option value="active" {% if status=='active' %}selected{% endif %}>Active</option><option value="pending" {% if status=='pending' %}selected{% endif %}>Pending</option><option value="suspended" {% if status=='suspended' %}selected{% endif %}>Suspended</option></select>
      <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    </form>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Joined</th><th>Actions</th></tr></thead>
        <tbody>
          {% for u in users %}
          <tr>
            <td>{{ u.id }}</td>
            <td>{{ u.name }}</td>
            <td>{{ u.email }}</td>
            <td>{{ u.role }}</td>
            <td><span class="status-badge status-{{ u.status }}">{{ u.status }}</span></td>
            <td>{{ u.created_at|date('M j, Y') }}</td>
            <td>
              <form method="POST" action="{{ app_url }}/admin/users/{{ u.id }}" style="display:flex;gap:4px">
                {{ csrf_token|raw }}
                <select name="status" onchange="this.form.submit()" title="Change status">
                  <option value="active"    {% if u.status=='active'    %}selected{% endif %}>Active</option>
                  <option value="pending"   {% if u.status=='pending'   %}selected{% endif %}>Pending</option>
                  <option value="suspended" {% if u.status=='suspended' %}selected{% endif %}>Suspended</option>
                  <option value="banned"    {% if u.status=='banned'    %}selected{% endif %}>Banned</option>
                </select>
              </form>
            </td>
          </tr>
          {% else %}
          <tr><td colspan="7" class="text-center">No users found.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </main>
</div>
{% endblock %}
