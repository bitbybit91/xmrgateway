{% extends 'layouts/base.twig' %}
{% block title %}Forgot Password — {{ app_name }}{% endblock %}
{% block content %}
<section class="auth-section">
  <div class="auth-container">
    <div class="auth-brand"><a href="{{ app_url }}/">{{ app_name }}</a></div>
    <h1 class="auth-title">Reset your password</h1>
    <p class="auth-sub">Enter your email and we'll send a reset link.</p>
    {% if flash_success %}<div class="alert alert-success">{{ flash_success }}</div>{% endif %}
    {% if flash_error %}<div class="alert alert-error">{{ flash_error }}</div>{% endif %}
    <form method="POST" action="{{ app_url }}/forgot-password" class="auth-form">
      {{ csrf_token|raw }}
      <div class="form-group">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Send Reset Link</button>
    </form>
    <p class="auth-switch"><a href="{{ app_url }}/login">Back to Login</a></p>
  </div>
</section>
{% endblock %}
