{% extends 'layouts/base.twig' %}
{% block title %}Reset Password — {{ app_name }}{% endblock %}
{% block content %}
<section class="auth-section">
  <div class="auth-container">
    <div class="auth-brand"><a href="{{ app_url }}/">{{ app_name }}</a></div>
    <h1 class="auth-title">Set new password</h1>
    {% if flash_error %}<div class="alert alert-error">{{ flash_error }}</div>{% endif %}
    <form method="POST" action="{{ app_url }}/reset-password" class="auth-form">
      {{ csrf_token|raw }}
      <input type="hidden" name="token" value="{{ token }}">
      <div class="form-group">
        <label for="password">New Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••" required minlength="8">
      </div>
      <div class="form-group">
        <label for="password_confirmation">Confirm Password</label>
        <input type="password" id="password_confirmation" name="password_confirmation" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Reset Password</button>
    </form>
  </div>
</section>
{% endblock %}
